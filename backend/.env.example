PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sqmanagement

# Shared secret used by the surreyquayphotostudio.com booking form when
# forwarding bookings to /api/bookings/website. Generate any long random
# string and set the same value on the website (MANAGEMENT_BOOKING_SECRET).
WEBSITE_BOOKING_SECRET=

# Stripe — leave STRIPE_SECRET_KEY blank to disable Stripe payment links.
# STRIPE_WEBHOOK_SECRET enables signature verification on the webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=gbp
STRIPE_PROMO_MESSAGE=Thank you for choosing Surrey Quays Photo Studio. Pay securely below.

# Cloudflare R2 — used for invoice PDFs and gallery photos.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Client galleries.
# ADMIN_SECRET gates /api/admin/* — send as X-Admin-Secret header.
# In NODE_ENV=production, missing ADMIN_SECRET blocks the admin endpoints (fail-closed).
ADMIN_SECRET=
# Cookie HMAC key for password-gated galleries. Falls back to ADMIN_SECRET if blank.
GALLERY_COOKIE_SECRET=
# Public base URL used when building share links + Stripe success/cancel URLs.
PUBLIC_APP_URL=http://localhost:5000
# Studio name shown above the cover hero on public galleries (and in the footer).
GALLERY_STUDIO_NAME=Surrey Quays Photo Studio
# Delivery shipping rate (minor units — pence). Defaults to 500 (£5).
GALLERY_DELIVERY_MINOR=500
# Auto discount applied to all gallery print orders (percent, 0-100).
# Server creates a Stripe coupon on first use named "gallery-<pct>pct".
# Set to 0 to disable.
GALLERY_DISCOUNT_PCT=20