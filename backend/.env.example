PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sqmanagement

# Shared secret used by the surreyquayphotostudio.com booking form when
# forwarding bookings to /api/bookings/website. Generate any long random
# string and set the same value on the website (MANAGEMENT_BOOKING_SECRET).
WEBSITE_BOOKING_SECRET=

# Stripe — leave STRIPE_SECRET_KEY blank to disable Stripe payment links.
# STRIPE_WEBHOOK_SECRET enables signature verification on the webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=gbp
STRIPE_PROMO_MESSAGE=Thank you for choosing Surrey Quays Photo Studio. Pay securely below.