PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sqmanagement

# Public URL of the frontend — used to build Stripe success/cancel return URLs.
FRONTEND_URL=https://sqmanagement.vercel.app

# Stripe — leave blank to disable Stripe Checkout. The backend degrades gracefully.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=gbp